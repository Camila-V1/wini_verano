void polinomioL::poner_termino2(int coef, int exp) {
    if (coef == 0) {
        return; // No hacer nada si el coeficiente es 0
    }

    // Paso 1: Asegurarse de que la lista sea lo suficientemente grande.
    // El grado del polinomio es (longitud - 1).
    int grado_actual = ls->getlongitud() - 1;
    while (exp > grado_actual) {
        ls->inserta_ultimo(0); // Añadir ceros hasta alcanzar el tamaño necesario
        grado_actual++;
    }

    // Paso 2: Encontrar la dirección (el nodo) en la posición del exponente.
    direccion d = ls->primero();
    for (int i = 0; i < exp; i++) {
        d = ls->siguiente(d);
        if (d == NULO) {
           // Esto es una salvaguarda, no debería ocurrir si la lógica de expansión es correcta.
           return;
        }
    }

    // Paso 3: Modificar el coeficiente en esa posición.
    // Se suma el nuevo coeficiente al que ya existía.
    int coef_actual = ls->recupera(d);
    ls->modifica(d, coef_actual + coef);

    // Opcional: Si el término de mayor grado se vuelve cero, se podría
    // acortar la lista para mantener el grado correcto.
    if (exp == ls->getlongitud() - 1 && ls->recupera(ls->fin()) == 0) {
        // Lógica para eliminar términos finales con coeficiente cero...
    }
}

